# ===========================================
# Security Headers - mjasion.pl
# ===========================================

# Global security headers for all pages. Vary: Accept because the same URL
# serves HTML or markdown depending on Accept (edge URL Rewrite Rules).
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), usb=()
  X-XSS-Protection: 0
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'none'; script-src 'self' 'unsafe-inline' giscus.app static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' giscus.app; img-src 'self' data: https:; font-src 'self'; connect-src 'self' cloudflareinsights.com; frame-src giscus.app; media-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; manifest-src 'self'
  Link: </index.xml>; rel="alternate"; type="application/atom+xml"; title="Marcin Jasion"
  Link: </sitemap-index.xml>; rel="sitemap"; type="application/xml"
  Vary: Accept, Accept-Encoding

# The PDF twin of /cv/ - point search engines at the HTML page instead
/cv.pdf
  Link: <https://mjasion.pl/cv/>; rel="canonical"

# Markdown twins of every page - keep them out of search results. Requests with
# Accept: text/markdown are rewritten to the .md path at the edge before they
# reach Pages, so this rule covers the negotiated responses too.
/*.md
  X-Robots-Tag: noindex

# Block indexing on non-production domains
https://mjasion.pages.dev/*
  X-Robots-Tag: noindex

https://:project.pages.dev/*
  X-Robots-Tag: noindex
