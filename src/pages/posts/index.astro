---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../../components/BlogCard.astro';
import { categoryColors, categoryLabels } from '../../data/portfolio';
import { getSortedPosts, groupByCategory, pluralPosts, postItemList, siteUrlOf } from '@/utils/posts';

const posts = await getSortedPosts();
// Biggest category first
const sortedCategories = groupByCategory(posts);

const siteUrl = siteUrlOf(Astro.site);

const collectionPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'All Posts',
  description: 'Articles on observability, Kubernetes, cloud infrastructure and AI agents for operations, grouped by topic.',
  url: `${siteUrl}/posts/`,
  mainEntity: postItemList(posts, siteUrl),
};
---

<BaseLayout
  title="All Posts"
  description="Articles on observability, Kubernetes, cloud infrastructure and AI agents for operations, grouped by topic."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(collectionPageSchema)} />
  </Fragment>
  <div class="mx-auto max-w-6xl px-4 py-8">
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">All Posts</h1>
    <p class="mt-2 text-gray-600 dark:text-gray-400">{posts.length} articles across {sortedCategories.length} categories</p>

    <div class="mt-10 space-y-12">
      {sortedCategories.map(([category, categoryPosts]) => (
        <section>
          <div class="flex items-center gap-3 mb-6">
            <a
              href={`/posts/${category}/`}
              class={`rounded-full px-3 py-1 text-sm font-medium ${categoryColors[category]} hover:opacity-80 transition-opacity`}
            >
              {categoryLabels[category] ?? category}
            </a>
            <span class="text-sm text-gray-500 dark:text-gray-400">
              {pluralPosts(categoryPosts.length)}
            </span>
          </div>
          <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
            {categoryPosts.map((post) => (
              <BlogCard post={post} />
            ))}
          </div>
        </section>
      ))}
    </div>
  </div>
</BaseLayout>
