---
import type { InferGetStaticPropsType } from 'astro';
import { render } from 'astro:content';
import PostLayout from '../../../layouts/PostLayout.astro';
import { getReadingTime } from '../../../data/portfolio';
import { getSortedPosts, popularTags as getPopularTags, postParams, postPath, type Post } from '@/utils/posts';

export async function getStaticPaths() {
  const posts = await getSortedPosts();
  // Tags that have their own page, so the post header can link them
  const popularTags = getPopularTags(posts);
  const navPost = (p: Post | undefined) =>
    p ? { title: p.data.title, href: postPath(p), category: p.data.category } : null;

  return posts.map((post, index) => {
    // Related posts: same category, excluding current, up to 3 (newest first)
    const related = posts
      .filter((p) => p.data.category === post.data.category && p.id !== post.id)
      .slice(0, 3)
      .map((p) => ({ ...navPost(p)!, date: p.data.date }));

    return {
      params: postParams(post),
      props: {
        post,
        popularTags,
        relatedPosts: related,
        // Posts are sorted DESC (newest first), so older = index+1, newer = index-1
        prevPost: navPost(posts[index + 1]),
        nextPost: navPost(posts[index - 1]),
      },
    };
  });
}

const { post, popularTags, relatedPosts, prevPost, nextPost } = Astro.props as InferGetStaticPropsType<typeof getStaticPaths>;
const { Content, headings } = await render(post);
const readingTime = getReadingTime(post.body);
---

<PostLayout
  title={post.data.title}
  seoTitle={post.data.seoTitle}
  description={post.data.description}
  date={post.data.date}
  dateModified={post.data.dateModified}
  category={post.data.category}
  tags={post.data.tags}
  hero={post.data.hero}
  headings={headings}
  readingTime={readingTime}
  popularTags={popularTags}
  relatedPosts={relatedPosts}
  prevPost={prevPost}
  nextPost={nextPost}
>
  <Content />
</PostLayout>
