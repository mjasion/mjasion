---
import type { InferGetStaticPropsType } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BlogCard from '../../../components/BlogCard.astro';
import BackToBlog from '../../../components/BackToBlog.astro';
import { categoryDescriptions, categoryLabels } from '../../../data/portfolio';
import { getSortedPosts, groupByCategory, pluralPosts, postItemList, siteUrlOf } from '@/utils/posts';

export async function getStaticPaths() {
  return groupByCategory(await getSortedPosts()).map(([category, categoryPosts]) => ({
    params: { category },
    props: { category, posts: categoryPosts },
  }));
}

const { category, posts } = Astro.props as InferGetStaticPropsType<typeof getStaticPaths>;
const label = categoryLabels[category] ?? category;
const description = categoryDescriptions[category] ?? `Articles about ${category}`;

const siteUrl = siteUrlOf(Astro.site);

const collectionPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${label} Articles`,
  description,
  url: `${siteUrl}/posts/${category}/`,
  mainEntity: postItemList(posts, siteUrl),
};
---

<BaseLayout
  title={`${label} Articles`}
  description={description}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(collectionPageSchema)} />
  </Fragment>
  <div class="mx-auto max-w-6xl px-4 py-8">
    <BackToBlog class="mb-6" />

    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">
      {label}
    </h1>
    <p class="mt-3 max-w-2xl text-gray-600 dark:text-gray-300 leading-relaxed">{description}.</p>
    <p class="mt-2 text-sm text-gray-500 dark:text-gray-500">{pluralPosts(posts.length)}</p>

    <div class="mt-8 grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => (
        <BlogCard post={post} />
      ))}
    </div>
  </div>
</BaseLayout>
