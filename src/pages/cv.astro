---
import BaseLayout from '../layouts/BaseLayout.astro';
import ObfuscatedEmail from '../components/ObfuscatedEmail.astro';
import { Download } from '@lucide/astro';
import { author, yearsSince, experiences, presentations } from '../data/portfolio';
import { education, languages, publications, skillGroups, credentials, emphasizeMetrics } from '../data/cv';
---

<BaseLayout
  title="CV"
  description={`CV of ${author.name} – ${author.role}: ${yearsSince('2012-12')} years in tech, Kubernetes, observability, multi-cloud (AWS, GCP), incident diagnosis and AI agents.`}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'ProfilePage',
      name: `CV – ${author.name}`,
      url: 'https://mjasion.pl/cv/',
      mainEntity: {
        '@type': 'Person',
        name: author.name,
        jobTitle: author.role,
        url: 'https://mjasion.pl',
        image: `https://mjasion.pl${author.image}`,
        knowsAbout: author.knowsAbout,
        sameAs: author.sameAs,
      },
    })} />
  </Fragment>
  <div class="mx-auto max-w-4xl px-4 py-12 print:px-0 print:py-0">

    <!-- Toolbar (hidden on print) -->
    <div class="mb-6 flex justify-end print:hidden">
      <a
        href="/cv.pdf"
        target="_blank"
        rel="noopener"
        class="group inline-flex items-center gap-2 rounded-full bg-gray-900 px-4 py-2 text-sm font-medium text-white hover:bg-gray-700 transition-colors"
      >
        <Download class="h-4 w-4 transition-transform duration-200 ease-out group-hover:translate-y-0.5" />
        Download PDF
      </a>
    </div>

    <article class="cv rounded-3xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-8 shadow-bento print:rounded-none print:border-none print:bg-white print:p-0 print:shadow-none">

      <!-- Header band -->
      <header class="cv-band -mx-8 -mt-8 rounded-t-[23px] px-8 pt-7 pb-5 print:mx-0 print:mt-0 print:rounded-none print:px-5 print:pt-5 print:pb-4">
        <h1 class="text-3xl font-bold tracking-tight text-(--cv-band-text) print:text-2xl">{author.name}</h1>
        <p class="mt-1 text-lg text-(--cv-band-role) print:text-base">{author.role}</p>
        <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-(--cv-band-muted) print:text-xs">
          <span>Warsaw, Poland</span>
          <ObfuscatedEmail email={author.email} class="hover:underline">
            {author.email}
          </ObfuscatedEmail>
          <a href="https://mjasion.pl" class="hover:underline">mjasion.pl</a>
          <a href="https://www.linkedin.com/in/marcinjasion" class="hover:underline" target="_blank" rel="noopener noreferrer">linkedin.com/in/marcinjasion</a>
          <a href="https://www.github.com/mjasion" class="hover:underline" target="_blank" rel="noopener noreferrer">github.com/mjasion</a>
        </div>
      </header>

      <!-- Summary -->
      <section class="mt-5 print:mt-4">
        <p class="text-base text-gray-700 dark:text-gray-300 leading-relaxed print:text-[11.5px]">
          {author.summary}
        </p>
      </section>

      <!-- Experience. Arbitrary print:text-[…] sizes only set font-size, so the print
           line-heights after the slash keep the screen classes from stretching the print.
           Print keeps each position whole, not each entry, and the company header stays
           with the first position, as in cv.pdf, so a long entry can span the break. -->
      <section class="mt-6 print:mt-5">
        <h2 class="cv-heading text-base font-semibold uppercase tracking-wider print:text-xs">Experience</h2>
        <div class="mt-3 space-y-5 print:space-y-3">
          {experiences.map((exp) => (
            <div>
              <div class="flex flex-wrap items-baseline justify-between gap-x-3 break-after-avoid">
                <h3 class="text-lg font-semibold print:text-sm">
                  <a href={exp.url} class="hover:text-accent-600 dark:hover:text-accent-400" target="_blank" rel="noopener noreferrer">{exp.company}</a>
                </h3>
                <span class="text-sm text-(--cv-muted) print:text-xs">{exp.location}</span>
              </div>
              <p class="mt-0.5 text-sm text-(--cv-muted) leading-snug break-after-avoid print:text-[10.5px]">
                {exp.overview}
              </p>
              {exp.positions.map((pos) => (
                <div class="mt-2 break-inside-avoid print:mt-1.5">
                  <div class="flex flex-wrap items-baseline justify-between gap-x-3">
                    <span class="text-base font-medium text-(--cv-accent) print:text-[12px]/[17.14px]">{pos.designation}</span>
                    <span class="text-sm text-(--cv-muted) print:text-xs">
                      {pos.start} – {pos.end ?? 'Present'}
                    </span>
                  </div>
                  <ul class="mt-1 list-disc space-y-0.5 pl-3 text-sm text-gray-700 dark:text-gray-300 marker:text-(--cv-accent) print:text-[10.5px]/[14px]">
                    {pos.responsibilities.map((r) => (
                      <li class="pl-1" set:html={emphasizeMetrics(exp.company, r)} />
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          ))}
        </div>
      </section>

      <!-- Skills -->
      <section class="mt-6 break-inside-avoid print:mt-5">
        <h2 class="cv-heading text-base font-semibold uppercase tracking-wider print:text-xs">Skills</h2>
        <ul class="mt-2 space-y-1 text-sm print:text-[10.5px]/[14px]">
          {skillGroups.map((group) => (
            <li class="flex flex-col gap-1 sm:flex-row sm:gap-3">
              <span class="shrink-0 font-medium text-gray-900 dark:text-gray-100 sm:w-36 sm:pt-px print:w-[120px]">{group.label}</span>
              <span class="flex flex-wrap gap-1">
                {group.items.map((item) => <span class="cv-chip">{item}</span>)}
              </span>
            </li>
          ))}
        </ul>
      </section>

      <!-- Certifications & Training -->
      <section class="mt-6 break-inside-avoid print:mt-5">
        <h2 class="cv-heading text-base font-semibold uppercase tracking-wider print:text-xs">Certifications &amp; Training</h2>
        <ul class="mt-2 space-y-1 text-sm text-gray-700 dark:text-gray-300 print:text-[10.5px]/[14px]">
          {credentials.map((cert) => (
            <li class="flex flex-wrap items-baseline justify-between gap-x-3">
              <span>
                <a href={cert.url} class="font-medium hover:text-accent-600 dark:hover:text-accent-400" target="_blank" rel="noopener noreferrer">{cert.name}</a>
                <span class="text-gray-500 dark:text-gray-400"> – {cert.organization}</span>
              </span>
              <span class="text-gray-500 dark:text-gray-400">{cert.timeline}</span>
            </li>
          ))}
        </ul>
      </section>

      <!-- Talks & Publications -->
      <section class="mt-6 break-inside-avoid print:mt-5">
        <h2 class="cv-heading text-base font-semibold uppercase tracking-wider print:text-xs">Talks & Publications</h2>
        <ul class="mt-2 space-y-1 text-sm text-gray-700 dark:text-gray-300 print:text-[10.5px]/[14px]">
          {presentations.map((talk) => (
            <li class="flex flex-wrap items-baseline justify-between gap-x-3">
              <span>
                <span class="font-medium">{talk.name}</span>
                <span class="text-gray-500 dark:text-gray-400"> – {talk.meetup}</span>
              </span>
              <span class="text-gray-500 dark:text-gray-400">{talk.date}</span>
            </li>
          ))}
          {publications.map((pub) => (
            <li class="flex flex-wrap items-baseline justify-between gap-x-3">
              <span>
                <a href={pub.url} class="font-medium hover:text-accent-600 dark:hover:text-accent-400" target="_blank" rel="noopener noreferrer">{pub.title}</a>
                <span class="text-gray-500 dark:text-gray-400"> – open-source contribution</span>
              </span>
              <span class="text-gray-500 dark:text-gray-400">{pub.year}</span>
            </li>
          ))}
        </ul>
      </section>

      <!-- Education & Languages (side by side) -->
      <div class="mt-6 grid grid-cols-1 gap-6 break-inside-avoid sm:grid-cols-2 print:mt-5 print:grid-cols-2">
        <section>
          <h2 class="cv-heading text-base font-semibold uppercase tracking-wider print:text-xs">Education</h2>
          <ul class="mt-2 space-y-1 text-sm text-gray-700 dark:text-gray-300 print:text-[10.5px]/[14px]">
            {education.map((ed) => (
              <li>
                <div class="font-medium">{ed.degree}</div>
                <div class="text-gray-500 dark:text-gray-400">{ed.school} · {ed.years}</div>
              </li>
            ))}
          </ul>
        </section>
        <section>
          <h2 class="cv-heading text-base font-semibold uppercase tracking-wider print:text-xs">Languages</h2>
          <ul class="mt-2 space-y-1 text-sm text-gray-700 dark:text-gray-300 print:text-[10.5px]/[14px]">
            {languages.map((lang) => (
              <li>
                <span class="font-medium">{lang.name}</span>
                <span class="text-gray-500 dark:text-gray-400"> – {lang.level}</span>
              </li>
            ))}
          </ul>
        </section>
      </div>
    </article>
  </div>
</BaseLayout>

<style>
  /* CV palette - cv.pdf.ts mirrors these values. The accent is the site's own
     accent token (accent-600, accent-400 in dark mode). The dark values only
     apply under .dark, which the light-only site never sets. */
  .cv {
    --cv-band-bg: #0f172a;
    --cv-band-border: transparent;
    --cv-band-text: #ffffff;
    --cv-band-role: #a5b4fc;
    --cv-band-muted: #cbd5e1;
    --cv-heading: #0f172a;
    --cv-accent: var(--color-accent-600);
    --cv-chip-bg: #eef2ff;
    --cv-chip-text: #3730a3;
    --cv-muted: #64748b;
    /* keep the band and chips backgrounds in print / save-as-PDF */
    print-color-adjust: exact;
    -webkit-print-color-adjust: exact;
  }
  :global(.dark) .cv {
    --cv-band-bg: #1e293b;
    --cv-band-border: #334155;
    --cv-heading: #f1f5f9;
    --cv-accent: var(--color-accent-400);
    --cv-chip-bg: #1e1b4b;
    --cv-chip-text: #c7d2fe;
    --cv-muted: #94a3b8;
  }

  .cv-band {
    background: var(--cv-band-bg);
    border: 1px solid var(--cv-band-border);
  }

  .cv-heading {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--cv-heading);
  }
  .cv-heading::before {
    content: '';
    width: 16px;
    height: 3px;
    flex-shrink: 0;
    border-radius: 9999px;
    background: var(--cv-accent);
  }

  .cv-chip {
    border-radius: 4px;
    padding: 1px 7px;
    background: var(--cv-chip-bg);
    color: var(--cv-chip-text);
    font-size: 12px;
    font-weight: 500;
    line-height: 16px;
  }

  @media print {
    :global(html), :global(body) {
      background: white !important;
      color: black !important;
    }
    :global(.dark .cv) {
      color: black !important;
    }
    /* print-color-adjust: exact would otherwise print the card's off-white
       (the theme's --color-white is #f8fafc) as a grey box */
    .cv {
      background: #ffffff !important;
    }
    .cv :global(a) {
      color: inherit !important;
      text-decoration: none;
    }
    .cv :global(h2),
    .cv :global(h3) {
      page-break-after: avoid;
    }
    /* screen chips run 1px larger, like the rest of the screen text */
    .cv-chip {
      font-size: 11px;
      line-height: 14px;
    }
    @page {
      margin: 14mm 14mm 14mm 14mm;
      size: A4;
    }
  }
</style>
