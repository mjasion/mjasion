---
import BaseLayout from '../layouts/BaseLayout.astro';
import ObfuscatedEmail from '../components/ObfuscatedEmail.astro';
import { Play, Workflow, FileCode, PiggyBank, ShieldCheck, ArrowUpRight } from '@lucide/astro';
import { author, yearsSince, skills, platformPractices, experiences, projects, certifications, trainings, presentations, categoryColors } from '../data/portfolio';

// Skills are grouped by their primary (first) category, so a multi-category skill
// (e.g. Prometheus = observability + container) lands in the group of its first one.
// Platform & DevOps practices have no brand logo, so their chips use Lucide
// icons instead.
interface SkillChip {
  name: string;
  summary: string;
  logo?: string;
  url?: string;
  icon?: string;
}

const practiceIcons: Record<string, typeof Workflow> = {
  workflow: Workflow,
  'file-code': FileCode,
  'piggy-bank': PiggyBank,
  'shield-check': ShieldCheck,
};

// Skills render as fixed rows of one or two cards on wide screens. In each row
// the `fill` card takes whatever width the other card's content leaves, so rows
// run edge to edge without JS. A group lists its matched skills in the order of its
// `match` categories, then any `extra` chips (practices with Lucide icons).
const skillRowDefs: { label: string; match?: string[]; extra?: SkillChip[]; fill?: boolean }[][] = [
  [
    { label: 'Cloud', match: ['cloud'] },
    { label: 'Containers & GitOps', match: ['container'], fill: true },
  ],
  [
    { label: 'Observability', match: ['observability'], fill: true },
    { label: 'Programming & AI', match: ['programming', 'ai'] },
  ],
  [
    { label: 'Platform & SRE', extra: platformPractices, fill: true },
  ],
];

const skillRows = skillRowDefs.map((row) =>
  row.map((def) => {
    const match = def.match ?? [];
    const matched = skills
      .filter((skill) => match.includes(skill.categories[0]))
      .sort((a, b) => match.indexOf(a.categories[0]) - match.indexOf(b.categories[0]));
    return {
      label: def.label,
      fill: def.fill ?? false,
      items: [...matched, ...(def.extra ?? [])] as SkillChip[],
    };
  }),
);
---

<BaseLayout title="About" imageAlt={`${author.name} – portrait`} description={`Senior SRE in Warsaw with ${yearsSince('2012-12')} years in tech – observability, alert quality, incident management, Kubernetes, and platform engineering.`}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: author.name,
      jobTitle: author.role,
      url: 'https://mjasion.pl',
      image: `https://mjasion.pl${author.image}`,
      description: author.summary,
      sameAs: author.sameAs,
      worksFor: {
        '@type': 'Organization',
        name: 'NatWest Boxed',
        url: 'https://www.natwestboxed.com',
      },
    })} />
  </Fragment>
  <div class="mx-auto max-w-5xl px-4 py-12 space-y-12">

    <!-- Hero / Intro -->
    <section class="rounded-3xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-8 shadow-bento">
      <h1 class="text-3xl font-bold">About Me</h1>
      <p class="mt-1 text-lg text-gray-600 dark:text-gray-300">{author.role}</p>
      <p class="mt-4 text-gray-600 dark:text-gray-300 leading-relaxed">
        {author.summary}
      </p>
      <div class="mt-4 flex flex-wrap items-center gap-3">
        {author.socialLinks.map((link) =>
          link.obfuscated ? (
            <ObfuscatedEmail
              email={author.email}
              class="inline-flex items-center gap-1 rounded-full bg-gray-100 dark:bg-gray-800 px-3 py-1.5 text-sm text-gray-600 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors"
            >
              {link.name}
            </ObfuscatedEmail>
          ) : (
            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1 rounded-full bg-gray-100 dark:bg-gray-800 px-3 py-1.5 text-sm text-gray-600 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors"
            >
              {link.name}
            </a>
          )
        )}
        <a
          href={author.cvUrl}
          class="inline-flex items-center gap-1 rounded-full bg-gray-900 dark:bg-white px-3 py-1.5 text-sm font-medium text-white dark:text-gray-900 hover:bg-gray-700 dark:hover:bg-gray-200 transition-colors"
        >
          View CV
        </a>
      </div>
    </section>

    <!-- Skills -->
    <section id="skills">
      <h2 class="mb-6 text-2xl font-bold">Skills</h2>
      <!-- Variable-width bento cards in fixed rows of two: the narrower card keeps its content
           width and the `fill` card stretches to the row's edge. Below xl the rows stack into a
           single column of full-width cards. -->
      <div class="space-y-4">
        {skillRows.map((row) => (
          <div class="flex flex-col gap-4 xl:flex-row">
            {row.map((group) => (
          <div class:list={[
            'rounded-2xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-5 shadow-bento',
            group.fill ? 'xl:min-w-0 xl:flex-1' : 'xl:flex-none',
          ]}>
            <h3 class="mb-3 text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">
              {group.label}
            </h3>
            <div class="flex flex-wrap gap-1.5">
              {group.items.map((skill) => {
                const Chip = skill.url ? 'a' : 'div';
                const Icon = skill.icon ? practiceIcons[skill.icon] : undefined;
                const descId = `skill-desc-${skill.name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
                return (
                  <Chip
                    {...(skill.url ? { href: skill.url, target: '_blank', rel: 'noopener noreferrer' } : {})}
                    aria-label={skill.name}
                    aria-describedby={descId}
                    data-skill-chip
                    class="group/skill relative inline-flex items-center gap-2 rounded-lg px-2.5 py-1.5 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors duration-200"
                  >
                    {skill.logo && (
                      <img
                        src={skill.logo}
                        alt={skill.name}
                        class="h-6 w-6 shrink-0 transition-transform duration-200 ease-out group-hover/skill:scale-110"
                        loading="lazy"
                      />
                    )}
                    {Icon && (
                      <Icon
                        aria-hidden="true"
                        class="h-6 w-6 shrink-0 text-gray-700 transition-transform duration-200 ease-out group-hover/skill:scale-110"
                      />
                    )}
                    <span class="whitespace-nowrap text-sm font-medium text-gray-900 dark:text-gray-100">{skill.name}</span>

                    {/* The description always ships in the HTML for screen readers and crawlers;
                        the visual tooltip below is a duplicate, hidden from assistive tech. */}
                    <span id={descId} class="sr-only">{skill.summary}</span>

                    {/* Visual tooltip: on hover for mouse users (sm+), on tap for touch devices via
                        data-open (script below). Kept display:none until shown (fading in via
                        @starting-style) so a hidden tooltip of a chip at the right edge can't widen the page. */}
                    <span
                      aria-hidden="true"
                      data-skill-tip
                      class="pointer-events-none absolute bottom-full left-1/2 z-20 mb-2 hidden w-56 -translate-x-1/2 rounded-lg bg-gray-900 px-3 py-2 text-xs leading-relaxed text-gray-100 shadow-lg transition-opacity duration-200 starting:opacity-0 sm:group-hover/skill:block group-data-open/skill:block dark:bg-gray-800"
                    >
                      {skill.summary}
                      <span data-skill-tip-arrow class="absolute left-1/2 top-full h-2 w-2 -translate-x-1/2 -translate-y-1 rotate-45 bg-gray-900 dark:bg-gray-800"></span>
                    </span>
                  </Chip>
                );
              })}
            </div>
          </div>
            ))}
          </div>
        ))}
      </div>

      <script>
        // Touch devices have no hover: the first tap on a skill chip opens its
        // tooltip, a second tap follows the chip's link (or closes a link-less
        // one), and a tap anywhere else closes it. Without JS the chip just
        // links out and the description stays in its sr-only span.
        (() => {
          const noHover = window.matchMedia('(hover: none)');
          let openChip = null;

          function close() {
            if (!openChip) return;
            openChip.removeAttribute('data-open');
            openChip = null;
          }

          // Nudge the tooltip back inside the viewport on narrow screens, keeping
          // its arrow pointed at the chip.
          function place(chip) {
            const tip = chip.querySelector('[data-skill-tip]');
            const arrow = chip.querySelector('[data-skill-tip-arrow]');
            if (!tip) return;
            tip.style.marginLeft = '';
            const margin = 8;
            const rect = tip.getBoundingClientRect();
            let shift = 0;
            if (rect.left < margin) shift = margin - rect.left;
            else if (rect.right > window.innerWidth - margin) shift = window.innerWidth - margin - rect.right;
            tip.style.marginLeft = `${shift}px`;
            if (arrow) arrow.style.marginLeft = `${-shift}px`;
          }

          document.addEventListener('click', (event) => {
            if (!noHover.matches) return;
            const chip = event.target instanceof Element ? event.target.closest('[data-skill-chip]') : null;
            if (chip && chip === openChip) {
              if (chip.tagName !== 'A') close();
              return;
            }
            close();
            if (!chip) return;
            event.preventDefault();
            chip.setAttribute('data-open', '');
            openChip = chip;
            place(chip);
          });
        })();
      </script>
    </section>

    <!-- Experience -->
    <section id="experience">
      <h2 class="mb-6 text-2xl font-bold">Experience</h2>
      <div class="space-y-6">
        {experiences.map((exp) => (
          <div class="rounded-2xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-6 shadow-bento hover:shadow-bento-hover hover:-translate-y-0.5 transition-all duration-200">
            <div class="flex items-start gap-4">
              {exp.logo && (
                <img src={exp.logo} alt={exp.company} class="h-12 w-12 shrink-0 rounded-lg" loading="lazy" />
              )}
              <div class="min-w-0">
                <h3 class="text-lg font-semibold">
                  <a href={exp.url} target="_blank" rel="noopener noreferrer" class="hover:text-accent-600 dark:hover:text-accent-400 transition-colors">
                    {exp.company}
                  </a>
                </h3>
                <p class="text-sm text-gray-500 dark:text-gray-400">{exp.location}</p>
              </div>
            </div>

            <div class="mt-4 space-y-4">
              {exp.positions.map((pos) => (
                <div class="border-l-2 border-gray-200 dark:border-gray-700 pl-4">
                  <div class="flex flex-wrap items-center gap-2">
                    <span class="font-medium">{pos.designation}</span>
                    <span class="text-sm text-gray-500 dark:text-gray-400">
                      {pos.start} – {pos.end || 'Present'}
                    </span>
                  </div>
                  <ul class="mt-2 space-y-1 text-sm text-gray-600 dark:text-gray-400">
                    {pos.responsibilities.map((r) => (
                      <li class="flex gap-2">
                        <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-gray-400 dark:bg-gray-600" />
                        <span set:html={r}></span>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Projects -->
    <section id="projects">
      <h2 class="mb-6 text-2xl font-bold">Projects</h2>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        {projects.map((project) => (
          <div class="flex flex-col rounded-2xl border border-gray-200 bg-white p-5 shadow-bento hover:shadow-bento-hover hover:-translate-y-0.5 transition-all duration-200">
            <h3 class="font-semibold">{project.name}</h3>
            <p class="mt-2 text-sm text-gray-600">{project.overview}</p>
            <ul class="mt-3 flex flex-wrap gap-1.5" aria-label="Tech stack">
              {project.stack.map((tech) => (
                <li class="rounded-md bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-700">{tech}</li>
              ))}
            </ul>
            {project.demo && (
              <p class="mt-auto pt-4 text-sm text-gray-500">
                <a href={project.demo} target="_blank" rel="noopener noreferrer" class="group inline-flex items-center gap-1 font-medium text-accent-600 hover:underline">
                  Live demo
                  <ArrowUpRight class="h-4 w-4 transition-transform duration-200 ease-out group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
                </a>
              </p>
            )}
          </div>
        ))}
      </div>
    </section>

    <!-- Certifications -->
    <section id="certifications">
      <h2 class="mb-6 text-2xl font-bold">Certifications</h2>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        {certifications.map((cert) => (
          <div class="rounded-2xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-5 shadow-bento hover:shadow-bento-hover hover:-translate-y-0.5 transition-all duration-200">
            <h3 class="font-semibold">
              <a href={cert.certificateUrl} target="_blank" rel="noopener noreferrer" class="hover:text-accent-600 dark:hover:text-accent-400 transition-colors">
                {cert.name}
              </a>
            </h3>
            <p class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-gray-500 dark:text-gray-400">
              <span>{cert.organization} &middot; {cert.timeline}</span>
              {cert.expired && (
                <span class="rounded-full bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-600">Expired</span>
              )}
            </p>
            <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
              {cert.overview}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- Training & Courses -->
    <section id="training">
      <h2 class="mb-6 text-2xl font-bold">Training &amp; Courses</h2>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        {trainings.map((course) => (
          <div class="rounded-2xl border border-gray-200 bg-white p-5 shadow-bento hover:shadow-bento-hover hover:-translate-y-0.5 transition-all duration-200">
            <h3 class="font-semibold">
              <a href={course.url} target="_blank" rel="noopener noreferrer" class="hover:text-accent-600 transition-colors">
                {course.name}
              </a>
            </h3>
            <p class="mt-1 text-sm text-gray-500">
              {course.organization} &middot; {course.timeline}
            </p>
            <p class="mt-2 text-sm text-gray-600">
              {course.overview}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- Presentations -->
    <section id="presentations">
      <h2 class="mb-6 text-2xl font-bold">Presentations</h2>
      <div class="space-y-4">
        {presentations.map((talk) => (
          <div class="rounded-2xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-5 shadow-bento hover:shadow-bento-hover hover:-translate-y-0.5 transition-all duration-200">
            <div class="flex items-start justify-between gap-4">
              <div>
                <h3 class="font-semibold">{talk.name}</h3>
                <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
                  <a href={talk.meetupUrl} target="_blank" rel="noopener noreferrer" class="hover:text-accent-600 dark:hover:text-accent-400 transition-colors">
                    {talk.meetup}
                  </a>
                  {' '}&middot; {talk.date}
                </p>
              </div>
              <div class="flex flex-wrap gap-2 shrink-0">
                {talk.assets.map((asset) => (
                  <a
                    href={asset.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group inline-flex items-center gap-1 rounded-full bg-red-100 dark:bg-red-900/30 px-3 py-1 text-xs font-medium text-red-800 dark:text-red-300 hover:bg-red-200 dark:hover:bg-red-900/50 transition-colors"
                  >
                    <Play class="h-3.5 w-3.5 transition-transform duration-200 ease-out group-hover:scale-125 group-hover:translate-x-0.5" />
                    {asset.title}
                  </a>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

  </div>
</BaseLayout>
