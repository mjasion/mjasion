---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { categoryColors } from '../data/portfolio';
import { formatMonthDay, getSortedPosts, groupBy, pluralPosts, siteUrlOf } from '@/utils/posts';

const posts = await getSortedPosts();
const postsByYear = groupBy(posts, (post) => post.data.date.getUTCFullYear());

const oldestYear = posts.at(-1)?.data.date.getUTCFullYear();
const description = `All posts in chronological order – Kubernetes, observability, Terraform, cloud networking and AI agents, from ${oldestYear} to today.`;

const siteUrl = siteUrlOf(Astro.site);

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
    { '@type': 'ListItem', position: 2, name: 'Archives' },
  ],
};
---

<BaseLayout
  title="Archives"
  description={description}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>
  <div class="mx-auto max-w-6xl px-4 py-8">
    <PageHeader
      title="Archives"
      lead="Every post in chronological order, newest first."
      meta={`${posts.length} posts since ${oldestYear}`}
    />

    <div class="space-y-10">
      {Array.from(postsByYear.entries()).map(([year, yearPosts]) => (
        <section>
          <h2 class="flex items-center gap-3 text-xl font-bold text-gray-900 dark:text-gray-100">
            <span>{year}</span>
            <span class="text-sm font-normal text-gray-500 dark:text-gray-400">({pluralPosts(yearPosts.length)})</span>
          </h2>
          <div class="mt-4 ml-4 border-l-2 border-gray-200 dark:border-gray-800 pl-6 space-y-4">
            {yearPosts.map((post) => (
              <div class="relative">
                <div class="absolute -left-[31px] top-1.5 h-2.5 w-2.5 rounded-full border-2 border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-950" />
                <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-3">
                  <time
                    datetime={post.data.date.toISOString()}
                    class="shrink-0 text-sm text-gray-500 dark:text-gray-400 tabular-nums"
                  >
                    {formatMonthDay(post.data.date)}
                  </time>
                  <span class={`inline-block self-start rounded-full px-2 py-0.5 text-xs font-medium ${categoryColors[post.data.category] ?? 'bg-gray-100 text-gray-800 dark:bg-gray-800 dark:text-gray-300'}`}>
                    {post.data.category}
                  </span>
                  <a
                    href={`/posts/${post.id}/`}
                    class="text-sm font-medium text-gray-900 dark:text-gray-100 hover:text-accent-600 dark:hover:text-accent-400 transition-colors"
                  >
                    {post.data.title}
                  </a>
                </div>
              </div>
            ))}
          </div>
        </section>
      ))}
    </div>
  </div>
</BaseLayout>
