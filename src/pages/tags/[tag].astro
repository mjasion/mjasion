---
import type { InferGetStaticPropsType } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../../components/BlogCard.astro';
import BackToBlog from '../../components/BackToBlog.astro';
import { getSortedPosts, groupByTag, MIN_POSTS_FOR_TAG_PAGE, pluralPosts, postItemList, siteUrlOf } from '@/utils/posts';

export async function getStaticPaths() {
  return [...groupByTag(await getSortedPosts())]
    .filter(([, tagPosts]) => tagPosts.length >= MIN_POSTS_FOR_TAG_PAGE)
    .map(([tag, tagPosts]) => ({
      params: { tag },
      props: { tag, posts: tagPosts },
    }));
}

const { tag, posts } = Astro.props as InferGetStaticPropsType<typeof getStaticPaths>;

const siteUrl = siteUrlOf(Astro.site);

const collectionPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `Posts tagged '${tag}'`,
  description: `Articles about ${tag} by Marcin Jasion`,
  url: `${siteUrl}/tags/${tag}/`,
  mainEntity: postItemList(posts, siteUrl),
};
---

<BaseLayout
  title={`Posts tagged '${tag}'`}
  description={`Articles about ${tag} by Marcin Jasion`}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(collectionPageSchema)} />
  </Fragment>
  <div class="mx-auto max-w-6xl px-4 py-8">
    <BackToBlog class="mb-6" />

    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">
      Posts tagged <span class="text-accent-600 dark:text-accent-400">'{tag}'</span>
    </h1>
    <p class="mt-2 text-gray-600 dark:text-gray-400">{pluralPosts(posts.length)}</p>

    <div class="mt-8 grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => (
        <BlogCard post={post} />
      ))}
    </div>
  </div>
</BaseLayout>
