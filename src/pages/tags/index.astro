---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getSortedPosts, MIN_POSTS_FOR_TAG_PAGE, siteUrlOf, tagCounts } from '@/utils/posts';

const posts = await getSortedPosts();
const sortedTags = tagCounts(posts);

const siteUrl = siteUrlOf(Astro.site);

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
    { '@type': 'ListItem', position: 2, name: 'Tags' },
  ],
};
---

<BaseLayout
  title="Tags"
  description="Browse all tags on Marcin Jasion's blog"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>
  <div class="mx-auto max-w-6xl px-4 py-8">
    <PageHeader
      back
      title="Tags"
      lead="Every topic covered on the blog – from Kubernetes and AWS to Terraform, observability, and platform engineering. Tags with five or more posts get their own page."
      meta={`${sortedTags.length} tags across ${posts.length} posts`}
    />

    <div class="flex flex-wrap gap-3">
      {sortedTags.map(([tag, count]) => {
        const isPopular = count >= MIN_POSTS_FOR_TAG_PAGE;
        return isPopular ? (
          <a
            href={`/tags/${tag}/`}
            class="inline-flex items-center gap-2 rounded-full border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 px-4 py-2 text-sm font-medium text-gray-700 dark:text-gray-300 hover:border-accent-500 dark:hover:border-accent-400 hover:text-accent-600 dark:hover:text-accent-400 hover:shadow-sm transition-all"
          >
            <span>{tag}</span>
            <span class="rounded-full bg-gray-100 dark:bg-gray-800 px-2 py-0.5 text-xs text-gray-500 dark:text-gray-400">{count}</span>
          </a>
        ) : (
          <span
            class="inline-flex items-center gap-2 rounded-full border border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-900/50 px-4 py-2 text-sm text-gray-500 dark:text-gray-500"
          >
            <span>{tag}</span>
            <span class="rounded-full bg-gray-100 dark:bg-gray-800 px-2 py-0.5 text-xs text-gray-400 dark:text-gray-500">{count}</span>
          </span>
        );
      })}
    </div>
  </div>
</BaseLayout>
