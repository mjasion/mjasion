---
import { Maximize2 } from '@lucide/astro';

interface Props {
  chart: string;
}

const { chart } = Astro.props;
---

<div class="mermaid-container group relative my-6 flex cursor-zoom-in justify-center rounded-xl bg-gray-50 p-4 transition-shadow duration-200 hover:shadow-md dark:bg-transparent dark:p-0 [&_svg]:max-w-full [&_svg]:min-w-[min(100%,600px)]">
  <pre class="mermaid not-prose bg-transparent! p-0! text-lg" set:html={chart} />
  <!-- Keyboard / screen reader way to open the enlarged view. A click anywhere on the
       container bubbles up to the same handler, so mouse users keep "click to enlarge". -->
  <button
    type="button"
    class="mermaid-enlarge absolute top-2 right-2 inline-flex min-h-8 min-w-8 items-center justify-center rounded-lg border border-gray-200 bg-white/90 text-gray-500 shadow-sm transition-opacity duration-200 hover:text-gray-900 print:hidden"
    aria-label="Enlarge diagram"
  >
    <Maximize2 class="h-4 w-4 transition-transform duration-200 ease-out motion-safe:group-hover:scale-110" aria-hidden="true" />
  </button>
</div>

<style>
  /* Reveal the enlarge button on hover or keyboard focus; on touch it stays visible. */
  @media (hover: hover) {
    .mermaid-enlarge {
      opacity: 0;
    }
    .mermaid-container:hover .mermaid-enlarge,
    .mermaid-container:focus-within .mermaid-enlarge {
      opacity: 1;
    }
  }
</style>

<script>
  // Heavy `mermaid` library is loaded lazily (dynamic import) only once a
  // diagram is about to scroll into view, so it stays out of the initial
  // critical request chain.
  type Mermaid = typeof import('mermaid').default;

  let mermaidPromise: Promise<Mermaid> | null = null;

  function loadMermaid(): Promise<Mermaid> {
    // Guard: dynamic import happens a single time, then is reused.
    if (!mermaidPromise) {
      mermaidPromise = import('mermaid').then((mod) => mod.default);
    }
    return mermaidPromise;
  }

  async function renderMermaid() {
    const mermaid = await loadMermaid();
    const isDark = document.documentElement.classList.contains('dark');
    // Restore original source before re-rendering
    const diagrams = document.querySelectorAll<HTMLElement>('.mermaid');
    diagrams.forEach((el) => {
      const source = el.dataset.source;
      if (source) {
        el.removeAttribute('data-processed');
        el.replaceChildren();
        el.insertAdjacentHTML('afterbegin', source);
      }
    });
    mermaid.initialize({
      startOnLoad: false,
      theme: isDark ? 'dark' : 'default',
    });
    mermaid.run({ querySelector: '.mermaid' });
  }

  // One shared native <dialog> per page, created here (this script runs once per
  // page no matter how many diagrams there are), so there are no duplicate IDs.
  // showModal() gives focus containment, Esc, inert page and focus return for free.
  let modal: HTMLDialogElement | null = null;
  let modalContent: HTMLElement | null = null;

  function getModal(): HTMLDialogElement {
    if (modal) return modal;
    modal = document.createElement('dialog');
    modal.setAttribute('closedby', 'any');
    modal.setAttribute('aria-label', 'Enlarged diagram');
    modal.className =
      'm-auto max-h-[90vh] w-[min(90vw,1200px)] max-w-none overflow-auto rounded-2xl border-0 bg-white p-4 shadow-xl sm:p-6 backdrop:bg-black/70 backdrop:backdrop-blur-sm dark:bg-gray-900';

    const header = document.createElement('div');
    header.className = 'flex justify-end';
    const close = document.createElement('button');
    close.type = 'button';
    close.className =
      'group inline-flex min-h-8 min-w-8 items-center justify-center rounded-full text-gray-500 transition-colors hover:bg-gray-100 hover:text-gray-900';
    close.setAttribute('aria-label', 'Close');
    close.innerHTML =
      '<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 transition-transform duration-200 ease-out motion-safe:group-hover:rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>';
    close.addEventListener('click', () => modal!.close());
    header.append(close);

    modalContent = document.createElement('div');
    modalContent.className = '[&_svg]:max-w-full';
    modal.append(header, modalContent);

    modal.addEventListener('close', () => modalContent!.replaceChildren());

    // Light dismiss where `closedby` is not supported (Safari): close only when the
    // press and the release both land outside the dialog box (on the backdrop).
    if (!('closedBy' in HTMLDialogElement.prototype)) {
      const outside = (e: PointerEvent) => {
        const r = modal!.getBoundingClientRect();
        return e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom;
      };
      let pressedOutside = false;
      modal.addEventListener('pointerdown', (e) => { pressedOutside = outside(e); });
      modal.addEventListener('pointerup', (e) => { if (pressedOutside && outside(e)) modal!.close(); });
    }

    document.body.append(modal);
    return modal;
  }

  function openModal(svgHtml: string) {
    const dialog = getModal();
    modalContent!.innerHTML = svgHtml;
    // Scale SVG to fill modal - remove fixed dimensions, use viewBox for scaling
    const svg = modalContent!.querySelector('svg');
    if (svg) {
      svg.removeAttribute('width');
      svg.style.maxWidth = 'none';
      svg.style.width = '100%';
      svg.style.height = 'auto';
      svg.style.maxHeight = '75vh';
    }
    dialog.showModal();
  }

  let rendered = false;

  // Trigger the (lazy) initial render exactly once. Subsequent theme-toggle
  // re-renders go straight through renderMermaid() since mermaid is cached.
  function renderOnce() {
    if (rendered) return;
    rendered = true;
    renderMermaid();
  }

  function init() {
    // --- Setup that does NOT need the mermaid library runs immediately ---

    // Store original chart source for re-rendering on theme change
    document.querySelectorAll<HTMLElement>('.mermaid').forEach((el) => {
      if (!el.dataset.source) {
        el.dataset.source = el.innerHTML;
      }
    });

    // Click to enlarge (the enlarge button's click bubbles up here too)
    document.querySelectorAll<HTMLElement>('.mermaid-container').forEach((container) => {
      container.addEventListener('click', () => {
        const svg = container.querySelector('.mermaid svg');
        if (svg) openModal(svg.outerHTML);
      });
    });

    // Watch for dark class toggle on <html> (debounced to prevent double-renders).
    // If the theme flips before any diagram has rendered yet, renderMermaid()
    // would pull in mermaid prematurely — so only re-render once initial render
    // has been triggered.
    let themeTimer: number;
    new MutationObserver(() => {
      if (!rendered) return;
      clearTimeout(themeTimer);
      themeTimer = window.setTimeout(renderMermaid, 100);
    }).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['class'],
    });

    // --- Defer loading + rendering mermaid until a diagram is near the viewport ---
    const diagrams = document.querySelectorAll<HTMLElement>('.mermaid');
    if (!diagrams.length) return;

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries, obs) => {
          if (entries.some((entry) => entry.isIntersecting)) {
            obs.disconnect();
            renderOnce(); // loads mermaid (once) and renders every diagram
          }
        },
        { rootMargin: '200px' }
      );
      diagrams.forEach((el) => observer.observe(el));
    } else {
      // Fallback: no IntersectionObserver support — load + render immediately.
      renderOnce();
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>
