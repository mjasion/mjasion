---
import BaseLayout from './BaseLayout.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { ArrowUp, ChevronLeft, ChevronRight, X } from '@lucide/astro';
import { author, categoryColors, categoryLabels } from '@/data/portfolio';
import type { MarkdownHeading } from 'astro';
import Comments from '@/components/Comments.astro';
import ShareButtons from '@/components/ShareButtons.astro';
import BackToBlog from '@/components/BackToBlog.astro';
import profileImg from '@/assets/images/mjasion.jpg';
import { formatPostDate, isoDate, siteUrlOf } from '@/utils/posts';

interface NavPost {
  title: string;
  href: string;
  category: string;
}

interface Props {
  title: string;
  seoTitle?: string;
  description: string;
  date: Date;
  dateModified?: Date;
  category: string;
  tags: string[];
  hero?: ImageMetadata | string;
  headings: MarkdownHeading[];
  readingTime: number;
  popularTags?: Set<string>;
  relatedPosts?: { title: string; href: string; category: string; date: Date }[];
  prevPost?: NavPost | null;
  nextPost?: NavPost | null;
}

const { title, seoTitle, description, date, dateModified, category, tags, hero, headings, readingTime, popularTags = new Set(), relatedPosts = [], prevPost, nextPost } = Astro.props;

const formattedDate = formatPostDate(date);
// Shown next to the publish date so the visible date matches JSON-LD dateModified
const updatedDate = dateModified && dateModified > date ? dateModified : undefined;

const tocHeadings = headings.filter((h) => h.depth <= 3);

const siteUrl = siteUrlOf(Astro.site);
const canonical = new URL(Astro.url.pathname, siteUrl).href;
const postPath = Astro.url.pathname.replace(/^\/posts\//, '').replace(/\/$/, '');
const ogImage = `${siteUrl}/og/${postPath}.png`;

const blogPostingSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: date.toISOString(),
  dateModified: (dateModified ?? date).toISOString(),
  author: {
    '@type': 'Person',
    name: author.name,
    url: siteUrl,
    image: `${siteUrl}${author.image}`,
    sameAs: author.sameAs,
  },
  publisher: {
    '@type': 'Person',
    name: author.name,
    url: siteUrl,
    image: `${siteUrl}${author.image}`,
    sameAs: author.sameAs,
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  image: ogImage,
  keywords: tags.join(', '),
  articleSection: category,
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
    { '@type': 'ListItem', position: 2, name: categoryLabels[category] ?? category, item: `${siteUrl}/posts/${category}/` },
    { '@type': 'ListItem', position: 3, name: title },
  ],
};
---

<BaseLayout
  title={seoTitle ?? title}
  titleSuffix={false}
  description={description}
  image={`/og/${postPath}.png`}
  articleDate={date}
  articleModifiedDate={dateModified}
  articleTags={tags}
  articleCategory={category}
  twitterCardType="summary_large_image"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(blogPostingSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>
  <!-- Reading progress bar: decorative (screen readers report position themselves).
       Driven by a CSS scroll timeline; the scroll script is only a fallback. -->
  <div
    id="reading-progress"
    class="fixed top-0 left-0 right-0 h-0.5 z-[60] pointer-events-none print:hidden"
    aria-hidden="true"
  >
    <div id="reading-progress-bar" class="h-full w-full origin-left bg-accent-500" style="transform: scaleX(0)"></div>
  </div>

  <article class="mx-auto max-w-5xl px-4 py-8">
    <!-- Header -->
    <header class="animate-bento-in">
      <div class="flex items-center gap-3 mb-6">
        <BackToBlog />
        <span class="text-gray-300 dark:text-gray-600">/</span>
        <a href={`/posts/${category}/`} class={`inline-block rounded-full px-3 py-1 text-xs font-medium ${categoryColors[category]} hover:opacity-80 transition-opacity`}>
          {category}
        </a>
      </div>

      <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">
        {title}
      </h1>

      <div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-gray-500 dark:text-gray-400">
        <time datetime={date.toISOString()}>{formattedDate}</time>
        {/* Each separator travels with the item after it, so a wrapped line never ends on a dot */}
        {updatedDate && (
          <span class="inline-flex items-center gap-3">
            <span aria-hidden="true">&middot;</span>
            <span>Updated <time datetime={isoDate(updatedDate)}>{formatPostDate(updatedDate)}</time></span>
          </span>
        )}
        <span class="inline-flex items-center gap-3">
          <span aria-hidden="true">&middot;</span>
          <span>{readingTime} min read</span>
        </span>
      </div>

      {tags.length > 0 && (
        <div class="mt-3 flex flex-wrap gap-2">
          {tags.map((tag) => (
            popularTags.has(tag) ? (
              <a href={`/tags/${tag}/`} class="rounded-md bg-gray-100 dark:bg-gray-800 px-2.5 py-1 text-xs text-gray-600 dark:text-gray-400 hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors">
                {tag}
              </a>
            ) : (
              <span class="rounded-md bg-gray-100 dark:bg-gray-800 px-2.5 py-1 text-xs text-gray-600 dark:text-gray-400">
                {tag}
              </span>
            )
          ))}
        </div>
      )}

      <!-- Share buttons (mobile/tablet fallback - hidden on xl when sidebar shows) -->
      <div class="mt-4 flex items-center gap-1 xl:hidden">
        <ShareButtons canonical={canonical} title={title} />
      </div>
    </header>

    {hero && (
      <div class="mt-8 animate-bento-in" style="animation-delay: 100ms">
        <Image
          src={hero}
          alt={title}
          width={1024}
          widths={[400, 640, 800, 992]}
          sizes="(max-width: 768px) calc(100vw - 2rem), 992px"
          format="webp"
          quality={80}
          class="w-full rounded-2xl"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    )}

    <!-- Content + outro (author/comments/nav) with optional TOC -->
    <div class="mt-10 xl:grid xl:grid-cols-[1fr_200px] xl:gap-8">
      <div class="min-w-0 animate-bento-in" style="animation-delay: 150ms">
        <div class="prose prose-lg dark:prose-invert max-w-none prose-headings:scroll-mt-16 lg:prose-headings:scroll-mt-8 prose-a:text-accent-600 dark:prose-a:text-accent-400 prose-img:rounded-xl">
          <slot />
        </div>

        <!-- Author card -->
        <div class="mt-12">
          <div class="flex items-center gap-4 rounded-2xl border border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-900/50 p-5">
            <Image
              src={profileImg}
              alt={author.name}
              width={112}
              height={112}
              format="webp"
              quality={80}
              class="h-14 w-14 shrink-0 rounded-full"
              loading="lazy"
            />
            <div>
              <p class="font-semibold text-gray-900 dark:text-gray-100">
                <a href="/about/" class="hover:text-accent-600 dark:hover:text-accent-400 transition-colors">{author.name}</a>
              </p>
              <p class="text-sm text-gray-500 dark:text-gray-400">{author.role}</p>
            </div>
          </div>
        </div>

        <Comments />

        <!-- Prev/Next navigation -->
        {(prevPost || nextPost) && (
          <nav class="mt-12" aria-label="Post navigation">
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
              {prevPost ? (
                <a
                  href={prevPost.href}
                  class="group flex flex-col rounded-2xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-5 hover:shadow-lg motion-safe:hover:-translate-y-0.5 transition-all duration-200"
                >
                  <span class="text-xs text-gray-500 dark:text-gray-400 flex items-center gap-1">
                    <ChevronLeft class="h-3 w-3 transition-transform duration-200 ease-out motion-safe:group-hover:-translate-x-0.5" />
                    Older post
                  </span>
                  <span class={`mt-1 inline-block self-start rounded-full px-2 py-0.5 text-xs font-medium ${categoryColors[prevPost.category] ?? ''}`}>
                    {prevPost.category}
                  </span>
                  <span class="mt-1.5 text-sm font-medium text-gray-900 dark:text-gray-100 line-clamp-2 group-hover:text-accent-600 dark:group-hover:text-accent-400 transition-colors">
                    {prevPost.title}
                  </span>
                </a>
              ) : <div />}
              {nextPost ? (
                <a
                  href={nextPost.href}
                  class="group flex flex-col items-end text-right rounded-2xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-5 hover:shadow-lg motion-safe:hover:-translate-y-0.5 transition-all duration-200"
                >
                  <span class="text-xs text-gray-500 dark:text-gray-400 flex items-center gap-1">
                    Newer post
                    <ChevronRight class="h-3 w-3 transition-transform duration-200 ease-out motion-safe:group-hover:translate-x-0.5" />
                  </span>
                  <span class={`mt-1 inline-block self-end rounded-full px-2 py-0.5 text-xs font-medium ${categoryColors[nextPost.category] ?? ''}`}>
                    {nextPost.category}
                  </span>
                  <span class="mt-1.5 text-sm font-medium text-gray-900 dark:text-gray-100 line-clamp-2 group-hover:text-accent-600 dark:group-hover:text-accent-400 transition-colors">
                    {nextPost.title}
                  </span>
                </a>
              ) : <div />}
            </div>
          </nav>
        )}
      </div>

      <aside class="hidden xl:block">
        <div class="sticky top-8 divide-y divide-gray-200 dark:divide-gray-800 rounded-2xl border border-gray-200 dark:border-gray-800 bg-gray-50 dark:bg-gray-900/50 text-sm">
          <!-- Share -->
          <div class="flex items-center justify-between p-5">
            <h2 class="font-semibold text-gray-900 dark:text-gray-100">Share</h2>
            <div class="flex items-center gap-1">
              <ShareButtons canonical={canonical} title={title} />
            </div>
          </div>

          {tocHeadings.length > 2 && (
            <nav id="toc-nav" class="p-5">
              <h2 class="mb-3 font-semibold text-gray-900 dark:text-gray-100">On this page</h2>
              <ul class="space-y-2 text-gray-500 dark:text-gray-400">
                {tocHeadings.map((heading) => (
                  <li style={`padding-left: ${(heading.depth - 2) * 0.75}rem`}>
                    <a
                      href={`#${heading.slug}`}
                      data-toc={heading.slug}
                      class="toc-link block transition-colors duration-150 hover:text-gray-900 dark:hover:text-gray-100"
                    >
                      {heading.text}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          )}

          <!-- Related posts (sidebar) -->
          {relatedPosts.length > 0 && (
            <div class="p-5">
              <h2 class="mb-3 font-semibold text-gray-900 dark:text-gray-100">Related</h2>
              <div class="space-y-3">
                {relatedPosts.map((related) => (
                  <a
                    href={related.href}
                    class="block text-sm leading-snug text-gray-600 dark:text-gray-400 hover:text-accent-600 dark:hover:text-accent-400 transition-colors line-clamp-2"
                  >
                    {related.title}
                  </a>
                ))}
              </div>
            </div>
          )}
        </div>
      </aside>
    </div>

    <!-- Related posts (mobile/tablet fallback - hidden on xl when sidebar shows) -->
    {relatedPosts.length > 0 && (
      <div class="mx-auto mt-12 max-w-3xl xl:hidden">
        <h2 class="text-xl font-bold text-gray-900 dark:text-gray-100 mb-4">Related posts</h2>
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {relatedPosts.map((related) => (
            <a
              href={related.href}
              class="block rounded-2xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-4 hover:shadow-md motion-safe:hover:-translate-y-0.5 transition-all duration-200"
            >
              <p class="text-sm font-medium leading-snug text-gray-900 dark:text-gray-100 line-clamp-2">
                {related.title}
              </p>
              <time class="mt-1.5 block text-xs text-gray-500 dark:text-gray-500" datetime={related.date.toISOString()}>
                {formatPostDate(related.date)}
              </time>
            </a>
          ))}
        </div>
      </div>
    )}

  </article>

  <!-- Back to top button with progress ring -->
  <button
    id="back-to-top"
    type="button"
    class="group fixed bottom-6 right-6 z-50 h-14 w-14 rounded-full bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-700 shadow-lg hover:shadow-xl print:hidden"
    aria-label="Back to top"
  >
    <svg class="h-14 w-14" viewBox="0 0 56 56">
      <circle cx="28" cy="28" r="24" fill="none" stroke-width="2.5" class="stroke-gray-200 dark:stroke-gray-700" />
      <circle id="btt-ring" cx="28" cy="28" r="24" fill="none" stroke-width="2.5" class="stroke-accent-500" stroke-linecap="round" stroke-dasharray="150.796" stroke-dashoffset="150.796" transform="rotate(-90 28 28)" />
    </svg>
    <ArrowUp class="absolute inset-0 m-auto h-5 w-5 text-gray-600 dark:text-gray-300 transition-transform duration-200 ease-out motion-safe:group-hover:-translate-y-0.5" />
  </button>

  <!-- Lightbox: native modal dialog. A click anywhere (image or backdrop) closes it,
       Esc and the back gesture close it natively. -->
  <dialog
    id="lightbox"
    closedby="any"
    aria-label="Image preview"
    class="m-auto max-h-none max-w-none overflow-visible border-0 bg-transparent p-0 cursor-zoom-out backdrop:bg-black/80 backdrop:backdrop-blur-sm print:hidden"
  >
    <img id="lightbox-img" class="max-h-[90vh] max-w-[90vw] rounded-xl object-contain" alt="" />
    <button
      type="button"
      class="group fixed top-4 right-4 inline-flex h-10 w-10 items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-white/20"
      aria-label="Close image preview"
    >
      <X class="h-6 w-6 transition-transform duration-200 ease-out motion-safe:group-hover:rotate-90" aria-hidden="true" />
    </button>
  </dialog>

  <!-- Live region for copy feedback (code blocks + copy link) -->
  <span id="copy-status" class="sr-only" role="status"></span>
</BaseLayout>

<style>
  .toc-link.is-active {
    color: var(--color-accent-600, #2563eb);
  }
  :global(.dark) .toc-link.is-active {
    color: var(--color-accent-400, #60a5fa);
  }

  /* Prose images are wrapped in a <button> by the lightbox script (keyboard access) */
  .prose :global(.lightbox-trigger) {
    display: block;
    width: fit-content;
    max-width: 100%;
    padding: 0;
    border: 0;
    border-radius: 0.75rem;
    background: none;
    font: inherit;
    color: inherit;
    cursor: zoom-in;
  }
  @media (prefers-reduced-motion: no-preference) {
    .prose :global(.lightbox-trigger img) {
      transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .prose :global(.lightbox-trigger:hover img) {
      transform: scale(1.03);
    }
  }

  /* Heading anchor links */
  .prose :global(.heading-anchor) {
    position: absolute;
    left: -1.5em;
    opacity: 0;
    color: var(--color-gray-400, #94a3b8);
    text-decoration: none;
    font-weight: 400;
    transition: opacity 0.2s;
  }
  .prose :global(h2:hover .heading-anchor),
  .prose :global(h3:hover .heading-anchor),
  .prose :global(h4:hover .heading-anchor),
  .prose :global(h5:hover .heading-anchor),
  .prose :global(h6:hover .heading-anchor),
  .prose :global(.heading-anchor:focus-visible) {
    opacity: 1;
  }
  @media (hover: none) {
    .prose :global(.heading-anchor) {
      opacity: 0.4;
    }
  }

  /* Copy button on code blocks */
  .prose :global(pre) {
    position: relative;
  }
  :global(.copy-btn) {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    padding: 0.25rem 0.5rem;
    font-size: 0.75rem;
    line-height: 1rem;
    border-radius: 0.375rem;
    border: 1px solid var(--color-gray-200, #cbd5e1);
    background: var(--color-glass, rgba(248, 250, 252, 0.7));
    color: var(--color-gray-500, #475569);
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.2s, background-color 0.2s;
    backdrop-filter: blur(4px);
  }
  :global(.dark .copy-btn) {
    border-color: var(--color-gray-700, #1e293b);
    background: rgba(15, 23, 42, 0.7);
    color: var(--color-gray-400, #64748b);
  }
  /* Reveal on hover AND keyboard focus, and keep it shown while feedback is visible */
  :global(pre:hover .copy-btn),
  :global(pre:focus-within .copy-btn),
  :global(.copy-btn:focus-visible),
  :global(.copy-btn[data-copied]),
  :global(.copy-btn[data-failed]) {
    opacity: 1;
  }
  :global(.copy-btn:hover) {
    background: var(--color-gray-100, #e2e8f0);
  }
  :global(.dark .copy-btn:hover) {
    background: var(--color-gray-800, #0f172a);
  }
  @media (hover: none) {
    :global(.copy-btn) {
      opacity: 1;
    }
  }

  /* Back-to-top: hidden with visibility (not only opacity) so it leaves the tab order */
  #back-to-top {
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s, visibility 0.3s, box-shadow 0.3s;
  }
  #back-to-top[data-visible] {
    opacity: 1;
    visibility: visible;
  }

  /* Reading progress: compositor-driven scroll timeline where supported */
  @supports (animation-timeline: scroll()) {
    @keyframes reading-progress {
      from { transform: scaleX(0); }
      to { transform: scaleX(1); }
    }
    /* Longhands on purpose: given the `animation` shorthand, the CSS minifier folds
       `animation-timeline` into it, a form Chrome rejects (no animation at all). */
    #reading-progress-bar {
      animation-name: reading-progress;
      animation-duration: auto;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: scroll(root block);
    }
  }
</style>

<script>
  // Shared live region: copy feedback is announced to screen readers, not only shown.
  const copyStatus = document.getElementById('copy-status');
  let lastMessage = '';
  function announce(message: string) {
    if (!copyStatus) return;
    // VoiceOver skips a message identical to the previous one; a no-break space makes it differ
    if (message === lastMessage) message += ' ';
    lastMessage = message;
    copyStatus.textContent = '';
    requestAnimationFrame(() => { copyStatus.textContent = message; });
  }
  const resetTimers = new WeakMap<Element, number>();
  function resetLater(el: Element, reset: () => void) {
    clearTimeout(resetTimers.get(el));
    resetTimers.set(el, window.setTimeout(() => {
      reset();
      if (copyStatus) copyStatus.textContent = '';
    }, 1500));
  }

  // Lightbox for prose images: each image is wrapped in a real <button> (keyboard
  // reachable), and the preview is a native modal <dialog>, which handles focus,
  // Esc/back gesture and returning focus to the image.
  const lightbox = document.getElementById('lightbox') as HTMLDialogElement | null;
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;

  if (lightbox && lightboxImg) {
    document.querySelectorAll<HTMLImageElement>('.prose img').forEach((img) => {
      if (img.closest('a, button')) return; // already interactive
      const target = img.parentElement?.tagName === 'PICTURE' ? img.parentElement : img;
      const trigger = document.createElement('button');
      trigger.type = 'button';
      trigger.className = 'lightbox-trigger';
      trigger.setAttribute('aria-label', img.alt ? `Enlarge image: ${img.alt}` : 'Enlarge image');
      target.replaceWith(trigger);
      trigger.append(target);
      trigger.addEventListener('click', () => {
        lightboxImg.src = img.currentSrc || img.src;
        lightboxImg.alt = img.alt;
        lightbox.showModal();
      });
    });

    // Click anywhere (image, close button or backdrop) closes, also where
    // `closedby` is unsupported (Safari).
    lightbox.addEventListener('click', () => lightbox.close());
    lightbox.addEventListener('close', () => lightboxImg.removeAttribute('src'));
  }

  // Copy button on code blocks
  document.querySelectorAll('.prose pre').forEach((pre) => {
    const code = pre.querySelector('code');
    if (!code) return;
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'copy-btn';
    btn.textContent = 'Copy';
    btn.setAttribute('aria-label', 'Copy code');
    btn.addEventListener('click', async () => {
      let ok = true;
      try {
        await navigator.clipboard.writeText(code.textContent ?? '');
      } catch {
        ok = false;
      }
      btn.toggleAttribute('data-copied', ok);
      btn.toggleAttribute('data-failed', !ok);
      btn.textContent = ok ? 'Copied!' : 'Failed';
      announce(ok ? 'Code copied' : 'Copy failed');
      resetLater(btn, () => {
        btn.textContent = 'Copy';
        btn.removeAttribute('data-copied');
        btn.removeAttribute('data-failed');
      });
    });
    pre.appendChild(btn);
  });

  // Heading anchor links
  document.querySelectorAll('.prose h2[id], .prose h3[id], .prose h4[id], .prose h5[id], .prose h6[id]').forEach((heading) => {
    const el = heading as HTMLElement;
    el.style.position = 'relative';
    const anchor = document.createElement('a');
    anchor.className = 'heading-anchor';
    anchor.href = `#${el.id}`;
    anchor.textContent = '#';
    anchor.setAttribute('aria-label', `Link to ${el.textContent}`);
    el.prepend(anchor);
  });

  // Scroll-driven UI: reading progress bar (fallback only), back-to-top ring and the
  // active TOC link. One passive listener, one requestAnimationFrame per frame, and the
  // layout values (viewport, document height, heading positions) are read once for all three.
  const progressBar = document.getElementById('reading-progress-bar');
  // Where CSS scroll timelines work, the bar is animated in CSS (see <style>)
  const nativeProgress = CSS.supports('animation-timeline', 'scroll()');
  const bttBtn = document.getElementById('back-to-top');
  const bttRing = document.getElementById('btt-ring');
  const CIRCUMFERENCE = 2 * Math.PI * 24; // r=24
  const tocLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.toc-link'));
  const headingEls = tocLinks
    .map((a) => document.getElementById(a.dataset.toc!))
    .filter((el): el is HTMLElement => el !== null);
  let activeTocId: string | undefined;
  let bttVisible: boolean | undefined;

  function updateToc(viewport: number, atBottom: boolean) {
    if (headingEls.length === 0) return;
    let activeId = headingEls[0].id;
    if (atBottom) {
      activeId = headingEls[headingEls.length - 1].id;
    } else {
      const midpoint = viewport * 0.4;
      for (const el of headingEls) {
        if (el.getBoundingClientRect().top > midpoint) break; // headings are in document order
        activeId = el.id;
      }
    }
    if (activeId === activeTocId) return;
    activeTocId = activeId;
    for (const link of tocLinks) link.classList.toggle('is-active', link.dataset.toc === activeId);
  }

  function onScrollFrame() {
    const viewport = window.innerHeight;
    const scrollY = window.scrollY;
    const scrollable = document.documentElement.scrollHeight - viewport;
    const scrolled = scrollable > 0 ? Math.min(scrollY / scrollable, 1) : 0;

    if (progressBar && !nativeProgress) {
      progressBar.style.transform = `scaleX(${scrolled})`;
    }

    if (bttBtn && bttRing) {
      bttRing.style.strokeDashoffset = String(CIRCUMFERENCE - scrolled * CIRCUMFERENCE);
      const visible = scrolled > 0.2;
      if (visible !== bttVisible) {
        bttVisible = visible;
        bttBtn.toggleAttribute('data-visible', visible);
      }
    }

    updateToc(viewport, scrollY >= scrollable - 2);
  }

  let scrollTicking = false;
  window.addEventListener('scroll', () => {
    if (scrollTicking) return;
    scrollTicking = true;
    requestAnimationFrame(() => {
      onScrollFrame();
      scrollTicking = false;
    });
  }, { passive: true });
  bttBtn?.addEventListener('click', () => {
    // The button hides once at the top, so move focus to the post title instead of
    // dropping it to <body> (keyboard users would restart from the page start).
    const title = document.querySelector<HTMLElement>('article h1');
    if (title) {
      title.tabIndex = -1;
      title.addEventListener('blur', () => title.removeAttribute('tabindex'), { once: true });
      title.focus({ preventScroll: true });
    }
    // behavior 'auto' follows the root's CSS scroll-behavior, which is smooth only
    // under prefers-reduced-motion: no-preference (motion-safe:scroll-smooth).
    window.scrollTo({ top: 0 });
  });
  onScrollFrame();

  // Copy link share buttons (multiple instances: mobile + sidebar)
  document.querySelectorAll('.copy-link-btn-trigger').forEach((btn) => {
    const icon = btn.querySelector('.copy-link-icon-el');
    const check = btn.querySelector('.copy-link-check-el');
    if (!icon || !check) return;
    btn.addEventListener('click', async () => {
      let ok = true;
      try {
        await navigator.clipboard.writeText(window.location.href);
      } catch {
        ok = false;
      }
      if (ok) {
        icon.classList.add('hidden');
        check.classList.remove('hidden');
      }
      announce(ok ? 'Link copied' : 'Copy failed');
      resetLater(btn, () => {
        icon.classList.remove('hidden');
        check.classList.add('hidden');
      });
    });
  });
</script>
